# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=   # e.g. https://<deployment>.convex.site

# Better Auth (set these in Convex env via `npx convex env set`)
# BETTER_AUTH_SECRET=generate with: openssl rand -base64 32
# SITE_URL=http://localhost:3000

# Cloudflare R2 (set these in Convex env via `npx convex env set`)
# R2_BUCKET=your-bucket-name
# R2_TOKEN=your-api-token
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Invite key for new user sign-ups (set via Convex settings table or admin UI)
# INVITE_KEY is stored in the Convex `settings` table, not in .env
